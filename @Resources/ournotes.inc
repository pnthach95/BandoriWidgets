[Variables]
; Default font, Karla, supports only english
Font=Karla
; Your UTC offset (ex: -3, 0, 8...) https://www.timeanddate.com/time/map/
UTCOffset=7

; By default, the progress bar fills up as the event goes, set this measure to 1 to invert it (make bar decrease as event goes)
InvertProgress=0

; This scales the whole skin (can be decimal, but not negative)
Size=0.7

ImgSize=50
Padding=10

; -------- CHANGE TEXT --------
; To change language, change these variables:

; Changes text before timer
StartText=Starts in
EndText=Ends in
; Text when event hasn't started
EventNotStarted= Event not started
; Changes the text in the timer
; if you want a space before/after the text, add it before/after and wrap the text in double quotes ex: " m "
; Default example: 4d 1h 43m 23s
Day="d "
Hour="h "
Minute="m "
Second="s"

; Available display languages: 0 = jp, 1 = en, 2 = zh-Hant, 3 = zh-Hans, 4 = ko
DisplayLang=1

; Background color
BGColor=255,255,255,0

; Border color
BorderColor=207,207,207,0

; Text color
TextColor=255,255,255
